PORT=3001
FRONTEND_URL=https://scanner.yourdomain.com
WPSCAN_API_KEY=your_wpscan_api_key_here

# WPScan API — економія квоти (default показано)
WPSCAN_DAILY_BUDGET=25          # макс. викликів WPScan API на добу (безкоштовний tier = 25)
WPSCAN_MAX_PLUGINS=5            # макс. плагінів, що запитуються на один сайт
WPSCAN_CACHE_TTL_MS=86400000   # час життя кешу для відповіді по плагіну (24 год)

# Пакетний режим
RATE_LIMIT_MAX=50              # ліміт запитів до /api/ за 15 хв
SCAN_BYPASS_TOKEN=             # секрет; запити з заголовком X-Scan-Token: <token> оминають rate-limit
